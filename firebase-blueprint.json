{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered gamer profile and account details",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Authentication user ID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "gamerTag": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "description": "Gamer handle or gamer tag"
        },
        "favoriteGame": {
          "type": "string",
          "description": "Primary game played"
        },
        "role": {
          "type": "string",
          "description": "Preferred game role or archetype"
        },
        "rank": {
          "type": "string",
          "description": "Current competitive rank or tier"
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Short gamer bio and description"
        },
        "photoUrl": {
          "type": "string",
          "description": "Avatar or profile photo data URL or image link"
        },
        "likedGenres": {
          "type": "array",
          "description": "Gaming genres the user enjoys like action, adventure, etc.",
          "items": {
            "type": "string"
          }
        },
        "likedGames": {
          "type": "array",
          "description": "Specific games the user enjoys",
          "items": {
            "type": "string"
          }
        },
        "socialLinks": {
          "type": "object",
          "description": "User social media profile links",
          "properties": {
            "discord": { "type": "string" },
            "twitch": { "type": "string" },
            "steam": { "type": "string" },
            "twitter": { "type": "string" },
            "youtube": { "type": "string" }
          }
        },
        "photos": {
          "type": "array",
          "description": "Uploaded gaming setup and screenshot photos",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "url": { "type": "string" },
              "caption": { "type": "string" },
              "uploadedAt": { "type": "string" }
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when account was created"
        }
      },
      "required": ["uid", "email", "gamerTag"]
    },
    "Squad": {
      "title": "Squad",
      "description": "Active squad beacon on the radar map",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique squad ID"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the squad creator"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48,
          "description": "Squad or clan name"
        },
        "game": {
          "type": "string",
          "description": "Game name"
        },
        "rank": {
          "type": "string",
          "description": "Target rank or tier"
        },
        "currentMembers": {
          "type": "number",
          "description": "Current number of members"
        },
        "maxMembers": {
          "type": "number",
          "description": "Max capacity of the squad"
        },
        "sector": {
          "type": "string",
          "description": "City or radar sector"
        },
        "locationName": {
          "type": "string",
          "description": "Location description"
        },
        "x": {
          "type": "number",
          "description": "Map coordinate X percent"
        },
        "y": {
          "type": "number",
          "description": "Map coordinate Y percent"
        },
        "micRequired": {
          "type": "boolean",
          "description": "Whether voice mic is required"
        },
        "playstyle": {
          "type": "string",
          "description": "Playstyle"
        },
        "description": {
          "type": "string",
          "maxLength": 280,
          "description": "Squad briefing description"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "ownerId", "name", "game"]
    },
    "Follow": {
      "title": "Follow",
      "description": "Follower and following social relationship between gamers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Combined followerId_followingId key" },
        "followerId": { "type": "string", "description": "User ID of the follower" },
        "followingId": { "type": "string", "description": "User ID being followed" },
        "followerGamerTag": { "type": "string", "description": "GamerTag of the follower" },
        "followerPhotoUrl": { "type": "string", "description": "Avatar of the follower" },
        "followingGamerTag": { "type": "string", "description": "GamerTag being followed" },
        "followingPhotoUrl": { "type": "string", "description": "Avatar being followed" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Follow timestamp" }
      },
      "required": ["id", "followerId", "followingId", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct message thread between two gamers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique conversation ID" },
        "participantIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "User IDs in the conversation"
        },
        "participantTags": {
          "type": "object",
          "description": "Map of user ID to gamerTag"
        },
        "participantPhotos": {
          "type": "object",
          "description": "Map of user ID to avatar URL"
        },
        "lastMessage": { "type": "string", "description": "Snippet of last message sent" },
        "lastMessageAt": { "type": "string", "description": "Timestamp of last message" },
        "lastSenderId": { "type": "string", "description": "User ID who sent the last message" },
        "unreadCounts": {
          "type": "object",
          "description": "Map of user ID to unread count"
        },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "participantIds"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual direct message within a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique message ID" },
        "conversationId": { "type": "string", "description": "Parent conversation ID" },
        "participantIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Both participant IDs for security lookup"
        },
        "senderId": { "type": "string", "description": "Author UID" },
        "senderGamerTag": { "type": "string", "description": "Author GamerTag" },
        "senderPhotoUrl": { "type": "string", "description": "Author avatar URL" },
        "receiverId": { "type": "string", "description": "Recipient UID" },
        "text": { "type": "string", "description": "Message text content" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Sent timestamp" },
        "read": { "type": "boolean", "description": "Whether message has been read" }
      },
      "required": ["id", "conversationId", "participantIds", "senderId", "receiverId", "text", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Friend request sent from one user to another",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique request ID (${senderId}_${receiverId})" },
        "senderId": { "type": "string", "description": "Sender User ID" },
        "senderGamerTag": { "type": "string", "description": "Sender Gamer Tag" },
        "senderPhotoUrl": { "type": "string", "description": "Sender Photo URL" },
        "senderAvatar": { "type": "string", "description": "Sender Character Avatar" },
        "receiverId": { "type": "string", "description": "Receiver User ID" },
        "receiverGamerTag": { "type": "string", "description": "Receiver Gamer Tag" },
        "receiverPhotoUrl": { "type": "string", "description": "Receiver Photo URL" },
        "receiverAvatar": { "type": "string", "description": "Receiver Character Avatar" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"], "description": "Request state" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Request creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Request update timestamp" }
      },
      "required": ["id", "senderId", "senderGamerTag", "receiverId", "receiverGamerTag", "status", "createdAt"]
    },
    "Friend": {
      "title": "Friend",
      "description": "Accepted friendship record between two gamers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique friendship ID" },
        "user1Id": { "type": "string", "description": "First User ID" },
        "user2Id": { "type": "string", "description": "Second User ID" },
        "user1Tag": { "type": "string", "description": "First Gamer Tag" },
        "user2Tag": { "type": "string", "description": "Second Gamer Tag" },
        "user1PhotoUrl": { "type": "string", "description": "First User Photo" },
        "user2PhotoUrl": { "type": "string", "description": "Second User Photo" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Friendship establishment timestamp" }
      },
      "required": ["id", "user1Id", "user2Id", "user1Tag", "user2Tag", "createdAt"]
    },
    "RoomPeer": {
      "title": "RoomPeer",
      "description": "Active voice participant in a chat room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "peerId": { "type": "string" },
        "userId": { "type": "string" },
        "gamerTag": { "type": "string" },
        "photoUrl": { "type": "string" },
        "isMicOn": { "type": "boolean" },
        "isSpeaking": { "type": "boolean" },
        "joinedAt": { "type": "number" },
        "lastSeen": { "type": "number" }
      },
      "required": ["id", "roomId", "peerId", "gamerTag", "isMicOn"]
    },
    "RoomSignal": {
      "title": "RoomSignal",
      "description": "WebRTC audio signaling message between room peers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "fromPeerId": { "type": "string" },
        "toPeerId": { "type": "string" },
        "type": { "type": "string", "enum": ["offer", "answer", "candidate", "bye"] },
        "payload": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "roomId", "fromPeerId", "toPeerId", "type", "payload", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Individual gamer account documents"
    },
    "/squads/{squadId}": {
      "schema": {
        "$ref": "#/entities/Squad"
      },
      "description": "Live squad beacons visible on the radar map"
    },
    "/follows/{followId}": {
      "schema": {
        "$ref": "#/entities/Follow"
      },
      "description": "Follower relationships between users"
    },
    "/conversations/{convId}": {
      "schema": {
        "$ref": "#/entities/Conversation"
      },
      "description": "Direct message conversation threads"
    },
    "/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/Message"
      },
      "description": "Direct messages sent between users"
    },
    "/friend_requests/{requestId}": {
      "schema": {
        "$ref": "#/entities/FriendRequest"
      },
      "description": "Pending and historical friend requests between users"
    },
    "/friends/{friendId}": {
      "schema": {
        "$ref": "#/entities/Friend"
      },
      "description": "Established mutual friendships between users"
    },
    "/room_peers/{peerId}": {
      "schema": {
        "$ref": "#/entities/RoomPeer"
      },
      "description": "Active voice room participants"
    },
    "/room_signals/{signalId}": {
      "schema": {
        "$ref": "#/entities/RoomSignal"
      },
      "description": "WebRTC audio signaling for live chat rooms"
    }
  }
}
