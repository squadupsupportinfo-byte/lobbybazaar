rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection (Gamer Accounts)
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.gamerTag is string
                    && request.resource.data.gamerTag.size() >= 2
                    && request.resource.data.gamerTag.size() <= 32;
      allow update: if isOwner(userId)
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    // Squads Collection (Radar Beacons & Stores)
    match /squads/{squadId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && isValidId(squadId)
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 128;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Follows Collection (Followers & Following Graph)
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.followerId == request.auth.uid;
    }

    // Conversations Collection (Direct Message Threads)
    match /conversations/{convId} {
      allow read, write: if isSignedIn();
    }

    // Messages Collection (Direct Messages)
    match /messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    // Friend Requests Collection
    match /friend_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // Friends Collection (Mutual Friendships)
    match /friends/{friendId} {
      allow read, write: if isSignedIn();
    }

    // Live Chat Room Messages Collection - Open to all room participants
    match /room_messages/{msgId} {
      allow read, create: if true;
      allow update, delete: if isSignedIn();
    }

    // Live Chat Room WebRTC Voice Peers & Presence - Open to all room participants
    match /room_peers/{peerDocId} {
      allow read, write: if true;
    }

    // Live Chat Room WebRTC Audio Signaling - Open to all room participants
    match /room_signals/{signalId} {
      allow read, write: if true;
    }

    // Airship Billboard Collection (Community Aerial Projection)
    match /airship_billboard/{docId} {
      allow read, write: if true;
    }
  }
}
